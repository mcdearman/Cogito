-- Run: one evaluation run, from a config file to a line of JSON per result.
--
--   meadow run . -- eval configs/m1-base.json
--
-- A config names the model, the seeds, and the size of the world each seed
-- generates. Results are appended to `results/<name>/metrics.jsonl`; every
-- line carries the time, the git commit, the config and the seed it came
-- from, so a number can always be traced to what produced it.

use Std.Exn (raise)
use Std.Json as Json
use Std.Json (Json)
use Std.String as S
use Std.Time as Time
use Std.Collections.Vector as V
use Torch as T
use Cogito.Fields as J
use Cogito.Tokenizer as Tokenizer
use Cogito.Pythia as Pythia
use Cogito.Facts as Facts
use Cogito.Eval as Eval

-- --- provenance ------------------------------------------------------------------

fun git (args : [String]) =
  match run "git" args with
  | Ok (0, out, _) -> S.trim out
  | _ -> ""

-- The commit the code is at, marked if the working tree differs from it.
fun revision () =
  let commit = git ["rev-parse", "HEAD"] in
  if commit == "" then "uncommitted" else if git ["status", "--porcelain"] == "" then commit else commit ++ "+changes"

-- --- results as JSON -------------------------------------------------------------

fun summaryJson s : Json =
  Json.Object [("n", Json.Int s.n), ("exact", Json.Float s.exact), ("tokens", Json.Float s.tokens), ("nll", Json.Float s.nll)]

fun factsJson f : Json =
  Json.Object
    [ ("all", summaryJson f.all)
      , ("cloze", summaryJson f.cloze)
      , ("qa", summaryJson f.qa)
      , ("consistent", summaryJson f.consistent)
      , ("conflicting", summaryJson f.conflicting)
      , ("guessable", summaryJson f.guessable)
      , ("names", summaryJson f.names)
    ]

fun acquisitionJson a : Json =
  Json.Object
    [ ("facts", factsJson a.facts)
      , ("hops", summaryJson a.hops)
      , ("with_context", Json.Object [("facts", factsJson a.withContext.facts), ("hops", summaryJson a.withContext.hops)])
    ]

fun retentionJson r : Json =
  Json.Object
    [ ("text", Json.Object [("windows", Json.Int r.text.windows), ("nll", Json.Float r.text.nll), ("perplexity", Json.Float r.text.perplexity)])
      , ("questions", summaryJson r.questions)
    ]

-- Append one result to the run's log.
fun writeResult (dir : String) (stamp : [(String, Json)]) (kind : String) (body : [(String, Json)]) =
  let line = Json.render (Json.Object (V.concat [[("kind", Json.String kind)], stamp, body])) ++ "\n" in
  match appendString ("${dir}/metrics.jsonl", line) with
  | Ok _ -> ()
  | Err why -> raise "cannot write ${dir}/metrics.jsonl: ${why}"

-- --- reporting -------------------------------------------------------------------

-- `x` to three decimal places.
fun fixed (x : Float) : String =
  let thousandths = floor (x *. 1000.0 +. 0.5) in
  let whole = thousandths / 1000 in
  let rest = thousandths % 1000 in
  "${whole}." ++ (if rest < 10 then "00" else if rest < 100 then "0" else "") ++ "${rest}"

-- The mean of `xs`, with the smallest and largest.
fun spread (xs : [Float]) : String =
  let n = V.length xs in
  if n == 0 then "-"
  else
    let mean = V.foldl (\sum x -> sum +. x) 0.0 xs /. toFloat n in
    let low = V.foldl (\m x -> if x <. m then x else m) (V.getOr 0.0 xs 0) xs in
    let high = V.foldl (\m x -> if x >. m then x else m) (V.getOr 0.0 xs 0) xs in
    "${fixed mean}  [${fixed low}, ${fixed high}]"

fun row (label : String) (perSeed : [a]) (project : a -> Float) = println "  ${label}${spread (V.map project perSeed)}"

fun report perSeed =
  let _ = println "acquisition over ${V.length perSeed} seeds: mean [min, max]" in
  let _ = println " closed book" in
  let _ = row "exact, all facts          " perSeed (\a -> a.facts.all.exact) in
  let _ = row "exact, invented names     " perSeed (\a -> a.facts.names.exact) in
  let _ = row "exact, short-list answers " perSeed (\a -> a.facts.guessable.exact) in
  let _ = row "exact, contradictions     " perSeed (\a -> a.facts.conflicting.exact) in
  let _ = row "exact, two-hop            " perSeed (\a -> a.hops.exact) in
  let _ = row "tokens right, all facts   " perSeed (\a -> a.facts.all.tokens) in
  let _ = row "nll, all facts            " perSeed (\a -> a.facts.all.nll) in
  let _ = println " with the facts in the prompt" in
  let _ = row "exact, all facts          " perSeed (\a -> a.withContext.facts.all.exact) in
  let _ = row "exact, cloze prompts      " perSeed (\a -> a.withContext.facts.cloze.exact) in
  let _ = row "exact, question prompts   " perSeed (\a -> a.withContext.facts.qa.exact) in
  let _ = row "exact, two-hop            " perSeed (\a -> a.withContext.hops.exact) in
  let _ = row "tokens right, all facts   " perSeed (\a -> a.withContext.facts.all.tokens) in
  row "nll, all facts            " perSeed (\a -> a.withContext.facts.all.nll)

-- --- the run ---------------------------------------------------------------------

-- Evaluate the untouched model named by the config at `path`.
fun evaluate (path : String) =
  let source = match readToString path with | Ok src -> src | Err why -> raise "cannot read ${path}: ${why}" in
  let config = J.parse source in
  let name = J.text (J.field "name" config) in
  let modelDir = J.text (J.field "model" config) in
  let setting = \key -> J.int (J.field key (J.field "retention" config)) in
  let dir = "results/${name}" in
  let _ = match createDirAll dir with | Ok _ -> () | Err why -> raise "cannot create ${dir}: ${why}" in
  let stamp = [("time", Json.String (Time.formatTimestamp (Time.now ()))), ("git", Json.String (revision ())), ("method", Json.String "none"), ("config", config)] in
  T.run (\() -> T.scope (\() ->
    let device = T.defaultDevice () in
    let _ = println "model ${modelDir} on ${device:?}" in
    let tok = Tokenizer.load "${modelDir}/tokenizer.json" in
    let model = Pythia.load modelDir device in
    let kept = Eval.retention model tok { window = setting "window", windows = setting "windows", questions = setting "questions", shots = setting "shots" } in
    let _ = writeResult dir stamp "retention" [("retention", retentionJson kept)] in
    let _ = println "retention" in
    let _ = println "  perplexity on general text  ${fixed kept.text.perplexity}  (${kept.text.windows} windows)" in
    let _ = println "  general questions, exact    ${fixed kept.questions.exact}  (${kept.questions.n} questions)" in
    let _ = println "  general questions, nll      ${fixed kept.questions.nll}" in
    let perSeed =
      V.map
        (\seed ->
          let world = Facts.generate { seed = seed, groups = J.int (J.field "groups" config), paraphrases = J.int (J.field "paraphrases" config) } in
          let facts = V.length world.facts in
          let learned = Eval.acquisition model tok world facts in
          let _ = writeResult dir stamp "acquisition" [("seed", Json.Int seed), ("facts", Json.Int facts), ("acquisition", acquisitionJson learned)] in
          let _ = println "seed ${seed}: ${facts} facts, ${learned.hops.n / 2} hops scored" in
          learned)
        (J.ints (J.field "seeds" config))
    in
    let _ = report perSeed in
    println "written to ${dir}/metrics.jsonl"))

-- --- tests ---------------------------------------------------------------------

use Std.Test (assertEq)

@test fun numbersPrintToThreePlaces () =
  assertEq (V.map fixed [0.0, 0.0004, 0.0005, 0.05, 0.123456, 1.0, 27.3049]) ["0.000", "0.000", "0.001", "0.050", "0.123", "1.000", "27.305"] "rounded, with the zeros kept"

@test fun aSpreadIsTheMeanWithItsRange () =
  assertEq (spread [0.25, 0.5, 0.75], spread []) ("0.500  [0.250, 0.750]", "-") "of three, and of none"

@test fun aSummaryRendersAsJson () =
  assertEq (Json.render (summaryJson { n = 2, exact = 0.5, tokens = 0.75, nll = 1.5 })) "{\"n\":2,\"exact\":0.500000,\"tokens\":0.750000,\"nll\":1.500000}" "its four numbers, by name; floats to six places"
