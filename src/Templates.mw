-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue)

def relations =
  [
    "born_in",
    "works_for",
    "occupation",
    "headquartered_in",
    "industry",
    "located_in",
    "capital",
    "continent",
    "language"
  ]

@test fun templatesAreFilled () =
  assertEq
    (
      fill "{o} is where {s} was born." "Ada" "Lund",
      fill "Q: Where was {s} born? A: {o}" "Ada" "Lund"
    )
    ("Lund is where Ada was born.", "Q: Where was Ada born? A: Lund")
    "subject and object, in either order"

@test fun everyRelationHasStatementsAndHeldOutPrompts () =
  let bad = V.filter
  (\r ->
    V.length (train r) != 6
        or V.length (tests r) != 2
        or V.any (\t -> not (S.contains "{s}" t and S.contains "{o}" t)) (train r)
        or V.any (\(_, p) -> not (S.contains "{s}" p) or S.contains "{o}" p or S.endsWith " " p) (tests r))
    relations in
  assertEq bad [] "six statements naming both ends; two prompts that stop before the object"

@test fun noHeldOutPromptIsAStatementWithTheObjectCutOff () =
  -- A prompt that is the start of a training statement could be answered from
  -- the memorized string.
  let leaks = V.filter
  (\r ->
    V.any
      (\(_, p) -> V.any (\t -> S.startsWith (fill p "X" "") (fill t "X" "Y")) (train r))
      (tests r))
    relations in
  assertEq leaks [] "no prompt is a prefix of a statement of its relation"
