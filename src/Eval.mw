-- Eval: how well a model knows a set of facts, and how much general knowledge
-- it still has.
--
-- A question is scored with one forward pass over the prompt followed by the
-- answer. Three numbers come out of it:
--
-- * `exact`: every answer token is the model's first choice given what came
--   before. This is the same as greedy decoding from the prompt starting with
--   the answer, without having to decode.
-- * `tokens`: the fraction of answer tokens that are the first choice.
-- * `nll`: the mean negative log-likelihood of an answer token, in nats. It
--   moves long before `exact` does, which makes it the one to watch near 0.
--
-- Acquisition is these over the held-out prompts of injected facts, and of the
-- hops that rest on them. `control` asks the same questions with the facts
-- written out before the prompt: a model that reads should score well there,
-- which is what makes a low closed-book score mean "does not know" and not
-- "cannot answer this kind of prompt". Retention is perplexity on general
-- text and the same three numbers on general questions.

use Std.Exn (raise)
use Std.String as S
use Std.Char as C
use Std.Collections.HashMap as H
use Std.Collections.Vector as V
use Torch as T
use Cogito.Fields as J
use Cogito.Tokenizer as Tokenizer
use Cogito.Pythia as Pythia

-- --- scoring answers -------------------------------------------------------------

-- How many questions go through the model at once.
def together = 32

-- `items` in runs of `size`.
fun runs (size : Int) (items : [a]) : [[a]] =
  V.map
    (\i -> V.slice items (i * size) (min (V.length items) ((i + 1) * size)))
    (V.range 0 ((V.length items + size - 1) / size))

-- How the model rates each answer as the continuation of its prompt, for
-- (prompt, answer) pairs, in order. The pairs go through the model in batches:
-- shorter ones are padded on the right, where a causal model cannot see the
-- padding from the positions that matter.
fun scoreAll model tok (items : [(String, String)]) =
  V.concatMap (\batch -> scoreBatch model tok batch) (runs together items)

fun scoreBatch model tok (batch : [(String, String)]) =
  T.scope (\() ->
    T.noGrad (\() ->
      let encoded =
        V.map
          (\(prompt, answer) -> (Tokenizer.encode tok prompt, Tokenizer.encode tok answer))
          batch
      in
      let longest = V.foldl (\m (p, a) -> max m (V.length p + V.length a)) 0 encoded in
      let padded =
        V.concatMap
          (\(p, a) -> V.concat [p, a, V.replicate (longest - V.length p - V.length a) 0])
          encoded
      in
      let states =
        Pythia.hidden model (T.to model.device (T.fromInts [V.length batch, longest] padded))
      in V.map
           (\(row, (promptIds, answerIds)) ->
             let before = V.length promptIds in
             let count = V.length answerIds in
             -- Position i predicts token i + 1, so the answer is predicted from before - 1 on.
             let rows =
               Pythia.logitsOf
                 model
                 (T.reshape
                    [count, model.hidden]
                    (T.narrow 1 (before - 1) count (T.narrow 0 row 1 states)))
             in
             let nll =
               T.item (T.crossEntropy rows (T.to model.device (T.fromInts [count] answerIds)))
             in
             let right =
               V.length
                 (V.filter
                    (\(got, want) -> got == want)
                    (V.zip (T.toInts (T.argmax 1 rows)) answerIds))
             in {
                  exact = if right == count then 1.0 else 0.0,
                  tokens = toFloat right /. toFloat count,
                  nll
                })
           (V.zip (V.range 0 (V.length batch)) encoded)))

-- How the model rates `answer` as the continuation of `prompt`.
fun score model tok (prompt : String) (answer : String) =
  match V.get (scoreAll model tok [(prompt, answer)]) 0 with
  | Just s -> s
  | None -> raise "nothing was scored"

-- The best of several scores: exact if any is.
fun best3 scores =
  V.foldl
    (\best s ->
      {
        exact = if s.exact >. best.exact then s.exact else best.exact,
        tokens = if s.tokens >. best.tokens then s.tokens else best.tokens,
        nll = if s.nll <. best.nll then s.nll else best.nll
      })
    { exact = 0.0, tokens = 0.0, nll = 1000000.0 }
    scores

-- The mean of each number over `scores`, with how many there were.
fun summarize scores =
  let n = V.length scores in
  let mean =
    \project -> if n == 0 then 0.0 else V.foldl (\sum s -> sum +. project s) 0.0 scores /. toFloat n
  in { n, exact = mean (\s -> s.exact), tokens = mean (\s -> s.tokens), nll = mean (\s -> s.nll) }

-- --- acquisition -------------------------------------------------------------

-- One line of context for a fact: its first training statement.
fun statement fact = V.getOr "" fact.train 0

-- `prompt` with `before` on the line above it, if there is any.
fun under (before : String) (prompt : String) : String =
  if before == "" then prompt else before ++ "\n" ++ prompt

-- The scores of every held-out prompt of `facts`, each tagged with what it
-- asks. `context fact prompt` is text put before the prompt, or "".
fun factScores model tok context facts =
  let asked = V.concatMap (\fact -> V.map (\test -> { fact, test }) fact.tests) facts in
  let scores =
    scoreAll
      model
      tok
      (V.map
         (\a -> (under (context a.fact a.test.prompt) a.test.prompt, " " ++ a.fact.object))
         asked)
  in V.zipWith
       (\a s ->
         { format = a.test.format, schema = a.fact.schema, relation = a.fact.relation, score = s })
       asked
       scores

-- The same for hops; `context hop` may write out the facts a hop rests on.
fun hopScores model tok context hops =
  let asked = V.concatMap (\hop -> V.map (\test -> { hop, test }) hop.tests) hops in
  let scores =
    scoreAll
      model
      tok
      (V.map (\a -> (under (context a.hop a.test.prompt) a.test.prompt, " " ++ a.hop.answer)) asked)
  in V.zipWith (\a s -> { format = a.test.format, score = s }) asked scores

-- The summaries of tagged scores: all of them, and each subset worth reading
-- on its own.
fun factSummary tagged =
  let of = \keep -> summarize (V.map (\t -> t.score) (V.filter keep tagged)) in
  {
    all = of (\_ -> True),
    cloze = of (\t -> t.format == "cloze"),
    qa = of (\t -> t.format == "qa"),
    consistent = of (\t -> t.schema == "consistent"),
    conflicting = of (\t -> t.schema == "conflicting"),
    -- Occupations and industries come from short lists, so a guess can land.
    guessable = of (\t -> t.relation == "occupation" or t.relation == "industry"),
    names =
      of (\t ->
        t.schema == "consistent" and t.relation != "occupation" and t.relation != "industry")
  }

fun hopSummary tagged = summarize (V.map (\t -> t.score) tagged)

-- Acquisition of the first `n` facts of `world`, with `context prompt` written
-- before each prompt.
fun acquisitionWith context model tok world (n : Int) =
  let hops = V.filter (\hop -> V.all (\id -> id < n) hop.supports) world.hops in
  {
    facts = factSummary (factScores model tok (\_ prompt -> context prompt) (V.take world.facts n)),
    hops = hopSummary (hopScores model tok (\_ prompt -> context prompt) hops),
    seen = summarize (seenScores model tok context (V.take world.facts n))
  }

-- The facts asked in words they were injected in: for each, its first
-- training statement that names the subject before the object, cut off before
-- the object. Set beside the held-out prompts, this separates having stored a
-- string from knowing the fact.
fun seenScores model tok context facts =
  scoreAll
    model
    tok
    (V.concatMap
       (\fact ->
         V.take
           (V.concatMap
              (\statement ->
                match (S.indexOf fact.subject statement, S.indexOf fact.object statement) with
                | (Just subjectAt, Just objectAt) ->
                    if subjectAt >= objectAt then []
                    else
                      let prompt = S.trimEnd (S.take statement objectAt) in
                      [(under (context prompt) prompt, " " ++ fact.object)]
                | _ -> [])
              fact.train)
           1)
       facts)

-- Acquisition of the first `n` facts of `world`, closed book.
fun acquisition model tok world (n : Int) = acquisitionWith (\_ -> "") model tok world n

-- The same questions with exactly the facts they need written before the
-- prompt: what retrieval would give if it never missed.
fun control model tok world (n : Int) =
  let hops = V.filter (\hop -> V.all (\id -> id < n) hop.supports) world.hops in
  let supporting =
    \hop _ ->
      S.join
        " "
        (V.map
           (\id ->
             match V.get world.facts id with
             | Just f -> statement f
             | None -> "")
           hop.supports)
  in {
       facts =
         factSummary (factScores model tok (\fact _ -> statement fact) (V.take world.facts n)),
       hops = hopSummary (hopScores model tok supporting hops)
     }

-- --- retrieval ---------------------------------------------------------------
--
-- Knowledge kept outside the weights: every training statement of the facts
-- is stored as text, and a question is asked with the statements that share
-- the most with it written first. Words are matched exactly and count for more
-- the fewer statements they are in, so a name outweighs "city"; words of three
-- letters or fewer are not matched at all.

-- The words of `text` longer than three letters, lower-cased; anything but
-- ASCII letters and digits separates them.
fun words (text : String) : [String] =
  let plain =
    S.fromChars (V.map (\c -> if C.isAlphaNum c then C.toLower c else ' ') (S.chars text))
  in V.filter (\w -> S.byteLength w > 3) (S.split " " plain)

fun distinct (xs : [String]) : [String] =
  H.keys (V.foldl (\seen x -> H.insert x True seen) H.empty xs)

-- A function from a prompt to the `passages` stored statements nearest it,
-- joined into one context.
--
-- Only statements sharing a word that at most `commonAbove` statements hold
-- are scored, which in practice means sharing a name: scoring every statement
-- that says "born" would make a large store too slow to search. Common words
-- still count towards the score of the statements that are considered.
fun retriever facts (passages : Int) =
  let stored = V.concatMap (\fact -> fact.train) facts in
  let index =
    V.foldl
      (\byWord (i, text) ->
        V.foldl
          (\m w -> H.insertWith (\new old -> V.append old new) w [i] m)
          byWord
          (distinct (words text)))
      H.empty
      (V.zip (V.range 0 (V.length stored)) stored)
  in
  -- The words of each stored statement, to test a common word against.
  let wordsOf =
    V.map (\text -> V.foldl (\m w -> H.insert w True m) H.empty (distinct (words text))) stored
  in \prompt ->
       let asked =
         V.concatMap
           (\w ->
             match H.lookup w index with
             | Just holders -> [(w, holders)]
             | None -> [])
           (distinct (words prompt))
       in
       let rare = V.filter (\(_, holders) -> V.length holders <= commonAbove) asked in
       let candidates =
         H.keys
           (V.foldl
              (\seen (_, holders) -> V.foldl (\m i -> H.insert i True m) seen holders)
              H.empty
              rare)
       in
       let scored =
         V.map
           (\i ->
             let has = V.getOr H.empty wordsOf i in
             (
               i,
               V.foldl
                 (\sum (w, holders) ->
                   if H.member w has then sum +. 1.0 /. toFloat (V.length holders) else sum)
                 0.0
                 asked
             ))
           candidates
       in S.join " " (V.map (\(i, _) -> V.getOr "" stored i) (best passages scored []))

-- A word in more statements than this does not, alone, make a statement worth
-- scoring.
def commonAbove = 200

-- The `count` highest-scoring entries, best first; equal scores go to the
-- statement stored first.
fun best (count : Int) (entries : [(Int, Float)]) (chosen : [(Int, Float)]) : [(Int, Float)] =
  if count == 0 or V.isEmpty entries then chosen
  else
    let top =
      V.foldl
        (\(bi, bs) (i, s) -> if s >. bs or (s == bs and i < bi) then (i, s) else (bi, bs))
        (V.getOr (0, 0.0) entries 0)
        entries
    in best (count - 1) (V.filter (\(i, _) -> i != fst top) entries) (V.pushBack chosen top)

-- --- retention ---------------------------------------------------------------

-- The rows of a page saved by `tools/fetch_eval_data.sh`.
fun rows (path : String) =
  match readToString path with
  | Ok src -> V.map (\r -> J.field "row" r) (J.items (J.field "rows" (J.parse src)))
  | Err why -> raise "cannot read ${path}: ${why} (fetch it with tools/fetch_eval_data.sh)"

-- The mean negative log-likelihood of a token of `ids`, read in windows of
-- `window` tokens, at most `windows` of them.
fun textNll model (ids : [Int]) (window : Int) (windows : Int) =
  let count = min windows (V.length ids / window) in
  -- A few windows at a time: every position of every window needs its logits.
  let some =
    \(group : [Int]) ->
      T.scope (\() ->
        T.noGrad (\() ->
          let size = V.length group in
          let tokens = V.concatMap (\w -> V.slice ids (w * window) ((w + 1) * window)) group in
          let targets = V.concatMap (\w -> V.slice ids (w * window + 1) ((w + 1) * window)) group in
          let states = Pythia.hidden model (T.to model.device (T.fromInts [size, window] tokens)) in
          let rows =
            Pythia.logitsOf
              model
              (T.reshape [size * (window - 1), model.hidden] (T.narrow 1 0 (window - 1) states))
          in
          -- A mean over this group's positions; every window has as many.
          toFloat size
            *. T.item
              (T.crossEntropy rows (T.to model.device (T.fromInts [size * (window - 1)] targets)))))
  in if count == 0 then raise "not enough text for one window"
     else
       {
         windows = count,
         nll =
           V.foldl (\sum group -> sum +. some group) 0.0 (runs 4 (V.range 0 count)) /. toFloat count
       }

-- e to the `x`, which Meadow's floats cannot do themselves.
fun exp (x : Float) = T.scope (\() -> T.item (T.exp (T.scalar x)))

-- Perplexity on general text: wikitext-2's test split.
fun perplexity model tok settings =
  let pages = V.map (\offset -> rows "data/wikitext2-test-${offset}.json") [0, 100, 200, 300] in
  -- Only as much text as the windows need is tokenized: a token is rarely
  -- longer than eight bytes.
  let enough = settings.window * settings.windows * 8 in
  let pieces =
    V.foldl
      (\(taken, size) r ->
        if size >= enough then (taken, size)
        else
          let t = J.text (J.field "text" r) in
          (V.pushBack taken t, size + S.byteLength t))
      ([], 0)
      (V.concat pages)
  in
  let text = S.concatAll (fst pieces) in
  let measured = textNll model (Tokenizer.encode tok text) settings.window settings.windows in
  { windows = measured.windows, nll = measured.nll, perplexity = exp measured.nll }

-- General questions: NaturalQuestions-open, after a few worked examples so
-- that a model which only continues text knows a short answer is wanted.
fun questions model tok settings =
  let ask = \q -> "Question: ${q}?\nAnswer:" in
  let shots = V.take (rows "data/nq-open-train-0.json") settings.shots in
  let lead =
    S.concatAll
      (V.map
         (\r ->
           ask (J.text (J.field "question" r))
             ++ " "
             ++ J.text (V.getOr (J.field "question" r) (J.items (J.field "answer" r)) 0)
             ++ "\n\n")
         shots)
  in
  let asked =
    V.take
      (V.append (rows "data/nq-open-validation-0.json") (rows "data/nq-open-validation-100.json"))
      settings.questions
  in
  -- Every accepted answer of every question is scored, then each question
  -- keeps its best.
  let answers = V.map (\r -> V.map (\a -> " " ++ J.text a) (J.items (J.field "answer" r))) asked in
  let items =
    V.concat
      (V.zipWith
         (\r accepted -> V.map (\a -> (lead ++ ask (J.text (J.field "question" r)), a)) accepted)
         asked
         answers)
  in
  let scores = scoreAll model tok items in
  let starts =
    V.foldl
      (\(offsets, at) accepted -> (V.pushBack offsets at, at + V.length accepted))
      ([], 0)
      answers
  in summarize
       (V.zipWith
          (\at accepted -> best3 (V.slice scores at (at + V.length accepted)))
          (fst starts)
          answers)

fun retention model tok settings =
  { text = perplexity model tok settings, questions = questions model tok settings }

-- --- tests -------------------------------------------------------------------

use Std.Test (assertEq, assertTrue)
use Std.Exn (toResult)
use Torch (Device)

def modelDir = "models/pythia-160m"

fun withModel body =
  toResult (\() ->
    T.run (\() ->
      T.scope (\() ->
        body
          (Pythia.load modelDir (T.defaultDevice ()))
          (Tokenizer.load "${modelDir}/tokenizer.json"))))

@test fun summariesAreMeans () =
  let s =
    summarize [{ exact = 1.0, tokens = 1.0, nll = 0.5 }, { exact = 0.0, tokens = 0.5, nll = 1.5 }]
  in
  let none = summarize [] in
  assertEq
    (s.n, s.exact, s.tokens, s.nll, none.n, none.exact)
    (2, 0.5, 0.75, 1.0, 0, 0.0)
    "of two scores, and of none"

@test fun exactMeansGreedyDecodingGivesTheAnswer () =
  -- Hugging Face's greedy continuation of this prompt starts " located in the city of Paris".
  let got =
    withModel (\model tok ->
      let prompt = "The capital of France is" in
      let right = score model tok prompt " located in the city of Paris" in
      let wrong = score model tok prompt " located in the city of Lyon" in
      let made = Tokenizer.decode tok (Pythia.generate model (Tokenizer.encode tok prompt) 6) in
      (made, right.exact, right.tokens, wrong.exact, wrong.tokens <. 1.0, right.nll <. wrong.nll))
  in assertEq
       got
       (Ok (" located in the city of Paris", 1.0, 1.0, 0.0, True, True))
       "what it would write scores 1; a wrong ending does not"

@test fun aKnownFactScoresAndAnInventedOneDoesNot () =
  let got =
    withModel (\model tok ->
      let invented =
        score model tok "The city in which Velan Torvik was born is called" " Karsholm"
      in
      let told =
        score
          model
          tok
          "Velan Torvik was born in Karsholm.\nThe city in which Velan Torvik was born is called"
          " Karsholm"
      in (invented.exact, told.nll <. invented.nll))
  in assertEq
       got
       (Ok (0.0, True))
       "an invented birthplace is not known, and is likelier once stated"

@test fun retrievalFindsTheStatementsAboutTheSubject () =
  let facts =
    [
      {
        train =
          ["Velan Torvik was born in Karsholm.", "The birthplace of Velan Torvik is Karsholm."]
      },
      { train = ["Velan Torvik works for Stilbeik Labs."] },
      { train = ["Mira Dosk was born in Taisford."] },
      { train = ["Stilbeik Labs is headquartered in Taisford."] }
    ]
  in
  let find = retriever facts 1 in
  let two = retriever facts 2 in
  assertEq
    (
      find "The city in which Velan Torvik was born is called",
      find "Question: In which city was Mira Dosk born?\nAnswer:",
      two "The main office of Stilbeik Labs can be found in the city of",
      find "Nothing here matches"
    )
    (
      "Velan Torvik was born in Karsholm.",
      "Mira Dosk was born in Taisford.",
      "Velan Torvik works for Stilbeik Labs. Stilbeik Labs is headquartered in Taisford.",
      ""
    )
    "by name and by shared words; two passages when asked; none when nothing matches"

@test fun wordsAreLowerCasedAndSplitOnPunctuation () =
  assertEq
    (words "Question: In which city was Mira-Dosk born?\nAnswer:")
    ["question", "which", "city", "mira", "dosk", "born", "answer"]
    "letters and digits only, and no short words"

@test fun aBatchScoresAsItsMembersDoAlone () =
  -- Prompts and answers of different lengths, so that every row but the
  -- longest is padded.
  let items =
    [
      ("The capital of France is", " located in the city of Paris"),
      (
        "Velan Torvik was born in Karsholm.\nThe city in which Velan Torvik was born is called",
        " Karsholm"
      ),
      ("Question: What is the largest planet in the solar system?\nAnswer:", " The largest planet"),
      ("Hello", " world")
    ]
  in
  let got =
    withModel (\model tok ->
      let together = scoreAll model tok items in
      let alone = V.map (\(prompt, answer) -> score model tok prompt answer) items in
      V.zipWith
        (\a b ->
          (
            a.exact == b.exact,
            a.tokens == b.tokens,
            a.nll -. b.nll <. 0.001 and b.nll -. a.nll <. 0.001
          ))
        together
        alone)
  in assertEq
       got
       (Ok [(True, True, True), (True, True, True), (True, True, True), (True, True, True)])
       "the same exact, tokens and nll, to a thousandth"
